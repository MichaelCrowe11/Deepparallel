# Example env for Deep Parallel
# Note: Ollama does not require an API key for local use.
# Some OpenAI-compatible clients require a token; use a dummy value.

OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# Optional: point to a remote Ollama host instead of localhost
# OLLAMA_HOST=http://your.remote.host:11434
# OLLAMA_API_KEY=583468e8809b45d8bceda9b29d1aa42c.uNL7GN1T_nHMkcHyoRrXD_Ye
